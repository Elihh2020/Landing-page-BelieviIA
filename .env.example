# URL pública do site (sem barra no final). Usada em metadata, OG e sitemap.
NEXT_PUBLIC_SITE_URL=https://believi.ia.br

# Número oficial de WhatsApp da Believi IA, formato internacional (já preenchido).
NEXT_PUBLIC_WHATSAPP_NUMBER=5511959132422

# ---- Rastreamento (Google) ----
# Contêiner do Google Tag Manager (já preenchido). GA4 e Google Ads são
# configurados DENTRO do GTM — não instale o Google Analytics direto no HTML.
NEXT_PUBLIC_GTM_ID=GTM-T4P6W9B9

# ---- Rastreamento (Meta) ----
NEXT_PUBLIC_META_PIXEL_ID=

# Token de acesso da Meta Conversions API (CAPI) — uso exclusivo no servidor
# (app/api/lead/route.ts), nunca exponha com o prefixo NEXT_PUBLIC_.
META_CAPI_ACCESS_TOKEN=

# ---- Envio paralelo opcional do formulário (desativado por padrão) ----
NEXT_PUBLIC_ENABLE_FORM_ENDPOINT=false
NEXT_PUBLIC_FORM_ENDPOINT=/api/lead

# Webhook para onde a rota /api/lead encaminha o lead (CRM, planilha, n8n etc).
LEAD_FORWARD_WEBHOOK_URL=
